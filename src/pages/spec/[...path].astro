---
import Base from "../../layouts/Base.astro";
import { getSiteData } from "../../lib/github";
import { specInventory, renderSpecDoc } from "../../lib/spec";

export async function getStaticPaths() {
  const docs = await specInventory();
  return docs.map((d) => ({ params: { path: d.slug }, props: { docPath: d.path } }));
}

const { docPath } = Astro.props as { docPath: string };
const data = await getSiteData();
const doc = await renderSpecDoc(docPath);
---

<Base
  active="spec"
  stars={data.stars}
  title={doc?.title ?? "Specification"}
  description={`${docPath} — rendered from the lemonfiber specification.`}>
  <section class="section head">
    <div class="container">
      <p class="eyebrow"><a href="/spec">Specification</a> · {docPath}</p>
      <h1 class="head__h">{doc?.title ?? "Document"}</h1>
      {
        doc && (
          <p class="spec-source">
            <a href={doc.source} target="_blank" rel="noopener">View source on GitHub ↗</a>
          </p>
        )
      }
    </div>
  </section>

  <section class="section">
    <div class="container spec-wrap">
      {
        doc && doc.toc.length >= 3 && (
          <nav class="spec-toc" aria-label="On this page">
            <p class="spec-toc__h">On this page</p>
            <ul>
              {doc.toc.map((t) => (
                <li class:list={[`lvl-${t.level}`]}>
                  <a href={`#${t.id}`}>{t.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
      {
        doc ? (
          <article class="spec-doc" set:html={doc.html} />
        ) : (
          <p class="spec-muted">This document could not be loaded right now.</p>
        )
      }
    </div>
  </section>

  <script is:inline type="module">
    // Render ```mermaid fences as diagrams. Loaded from CDN only when a page
    // actually has one, and left as a code block if the render fails.
    const blocks = document.querySelectorAll("pre > code.language-mermaid");
    if (blocks.length) {
      const root = document.documentElement;
      const dark =
        root.dataset.theme === "ink" ||
        (!root.dataset.theme &&
          window.matchMedia("(prefers-color-scheme: dark)").matches);
      try {
        const { default: mermaid } = await import(
          "https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs"
        );
        mermaid.initialize({
          startOnLoad: false,
          theme: dark ? "dark" : "default",
          securityLevel: "strict",
        });
        blocks.forEach((code) => {
          const div = document.createElement("div");
          div.className = "mermaid";
          div.textContent = code.textContent;
          code.parentElement.replaceWith(div);
        });
        await mermaid.run({ querySelector: ".mermaid" });
      } catch {
        /* leave the fenced code block untouched */
      }
    }
  </script>
</Base>

<style>
  .spec-doc :global(.mermaid) {
    display: flex;
    justify-content: center;
    margin: 1.75rem 0;
  }
  .spec-source {
    margin-top: 0.5rem;
    font-weight: 600;
  }
  .spec-muted {
    opacity: 0.7;
  }
  .spec-wrap {
    max-width: 78ch;
  }
  .spec-toc {
    margin: 0 0 2rem;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--border, #333);
    border-radius: 8px;
    background: var(--bg-tint, rgba(128, 128, 128, 0.08));
    font-size: 0.9rem;
  }
  .spec-toc__h {
    font-weight: 700;
    margin: 0 0 0.4rem;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    opacity: 0.7;
  }
  .spec-toc ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.2rem;
  }
  .spec-toc .lvl-3 {
    padding-left: 1rem;
    font-size: 0.86rem;
    opacity: 0.85;
  }
  .spec-toc a {
    text-decoration: none;
    color: inherit;
  }
  .spec-toc a:hover {
    color: var(--accent-strong, #d98a3a);
    text-decoration: underline;
  }
  .spec-doc :global(h2),
  .spec-doc :global(h3) {
    scroll-margin-top: 5rem;
  }
  .spec-doc :global(h2) {
    margin-top: 2.25rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--border, #333);
  }
  .spec-doc :global(h3) {
    margin-top: 1.75rem;
  }
  .spec-doc :global(p),
  .spec-doc :global(li) {
    line-height: 1.7;
  }
  .spec-doc :global(ul),
  .spec-doc :global(ol) {
    padding-left: 1.4rem;
  }
  .spec-doc :global(a) {
    color: var(--accent-strong, #d98a3a);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
  .spec-doc :global(blockquote) {
    margin: 1.25rem 0;
    padding: 0.5rem 1rem;
    border-left: 3px solid var(--accent-strong, #d98a3a);
    opacity: 0.9;
  }
  .spec-doc :global(code) {
    font-family: var(--font-mono, monospace);
    font-size: 0.9em;
    background: var(--bg-tint, rgba(128, 128, 128, 0.12));
    padding: 0.1em 0.35em;
    border-radius: 4px;
  }
  .spec-doc :global(pre) {
    overflow-x: auto;
    padding: 1rem;
    border-radius: 8px;
    background: var(--bg-tint, rgba(128, 128, 128, 0.12));
    border: 1px solid var(--border, #333);
  }
  .spec-doc :global(pre code) {
    background: none;
    padding: 0;
  }
  .spec-doc :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.25rem 0;
    display: block;
    overflow-x: auto;
    font-size: 0.92rem;
  }
  .spec-doc :global(th),
  .spec-doc :global(td) {
    border: 1px solid var(--border, #333);
    padding: 0.5rem 0.7rem;
    text-align: left;
    vertical-align: top;
  }
  .spec-doc :global(th) {
    background: var(--bg-tint, rgba(128, 128, 128, 0.12));
  }
</style>

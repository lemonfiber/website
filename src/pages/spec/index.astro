---
import Base from "../../layouts/Base.astro";
import { getSiteData } from "../../lib/github";
import { specGroups } from "../../lib/spec";
import { site } from "../../data/site";

const data = await getSiteData();
const groups = await specGroups();
const total = groups.reduce((n, g) => n + g.docs.length, 0);
---

<Base
  active="spec"
  stars={data.stars}
  title="Specification"
  description="The complete lemonfiber specification, rendered on-site — every document, sourced live from GitHub.">
  <section class="section head">
    <div class="container">
      <p class="eyebrow">The specification</p>
      <h1 class="head__h">The whole spec, for humans.</h1>
      <p class="lead head__lead">
        Lemonfiber is spec-first: every line of code cites a requirement that
        already exists here. This is the entire specification — {total} documents
        across {groups.length} sections — rendered on-site and sourced live from
        the <a href={`${site.specUrl}`} target="_blank" rel="noopener">spec repository</a>.
        Every page links back to its source.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <input
        id="spec-search"
        class="spec-search"
        type="search"
        placeholder="Filter the spec by title…"
        aria-label="Filter the spec by title"
        autocomplete="off"
      />
      <div class="spec-grid" id="spec-grid">
        {
          groups.map((g) => (
            <div class="spec-col card">
              <h2 class="spec-col__h">{g.section}</h2>
              <ul class="spec-col__list">
                {g.docs.map((d) => (
                  <li>
                    <a href={`/spec/${d.slug}`}>{d.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
      <p class="spec-nomatch" hidden>No documents match that filter.</p>
    </div>
  </section>

  <script is:inline>
    (() => {
      const input = document.getElementById("spec-search");
      const grid = document.getElementById("spec-grid");
      if (!input || !grid) return;
      const cols = Array.from(grid.children);
      const nomatch = document.querySelector(".spec-nomatch");
      input.addEventListener("input", () => {
        const q = input.value.trim().toLowerCase();
        let shown = 0;
        cols.forEach((col) => {
          let any = 0;
          col.querySelectorAll("li").forEach((li) => {
            const hit = !q || li.textContent.toLowerCase().includes(q);
            li.hidden = !hit;
            if (hit) any++;
          });
          col.hidden = any === 0;
          if (any > 0) shown++;
        });
        if (nomatch) nomatch.hidden = shown !== 0;
      });
    })();
  </script>
</Base>

<style>
  .spec-search {
    font: inherit;
    width: 100%;
    max-width: 32rem;
    padding: 0.6rem 0.9rem;
    margin-bottom: 1.5rem;
    border-radius: 8px;
    border: 1px solid var(--border, #333);
    background: var(--bg-tint, rgba(128, 128, 128, 0.08));
    color: inherit;
  }
  .spec-search:focus {
    outline: none;
    border-color: var(--accent, #d98a3a);
  }
  .spec-nomatch {
    opacity: 0.7;
    margin-top: 1rem;
  }
  .spec-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 1rem;
    align-items: start;
  }
  .spec-col {
    padding: 1.1rem 1.25rem;
  }
  .spec-col__h {
    font-size: 1rem;
    margin-bottom: 0.6rem;
  }
  .spec-col__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.35rem;
  }
  .spec-col__list a {
    text-decoration: none;
    font-size: 0.92rem;
  }
  .spec-col__list a:hover {
    text-decoration: underline;
  }
</style>

---
import Base from "../layouts/Base.astro";
import { getSiteData, getRfc } from "../lib/github";
import { site } from "../data/site";
import { relativeTime } from "../lib/format";

const data = await getSiteData();
const { issues, drafts } = await getRfc();
const newRfcUrl = `${site.githubOrg}/spec/issues/new?template=rfc.yml`;
---

<Base
  active="rfc"
  stars={data.stars}
  title="RFC"
  description="What's under consideration — open RFCs and Draft requirements — before it binds.">
  <section class="section head">
    <div class="container">
      <p class="eyebrow">Request for comments</p>
      <h1 class="head__h">What's being considered.</h1>
      <p class="lead head__lead">
        The spec is canonical, but nothing lands without discussion. This is the
        pre-approval feed: open <strong>RFC issues</strong> anyone can weigh in
        on, and the spec's own <strong>Draft</strong> requirements — proposed,
        not yet binding. When a maintainer approves an RFC it becomes a Draft
        spec PR automatically; merging that hardens it into the spec.
      </p>
      <div class="head__cta">
        <a class="rfc-cta" href={newRfcUrl} target="_blank" rel="noopener">Open an RFC →</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="rfc-h">Open RFCs <span class="rfc-count">{issues.length}</span></h2>
      {
        issues.length === 0 ? (
          <p class="rfc-muted">
            No open RFCs right now.{" "}
            <a href={newRfcUrl} target="_blank" rel="noopener">Propose one.</a>
          </p>
        ) : (
          <ul class="rfc-list">
            {issues.map((i) => (
              <li class="card rfc-item">
                <a href={i.url} target="_blank" rel="noopener" class="rfc-item__title">{i.title}</a>
                <div class="rfc-item__meta">
                  <span>#{i.number}</span>
                  <span>· opened {relativeTime(i.createdAt)}</span>
                  {i.labels.filter((l) => l !== "rfc").map((l) => <span class="rfc-tag">{l}</span>)}
                </div>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="rfc-h">Draft requirements <span class="rfc-count">{drafts.length}</span></h2>
      <p class="rfc-muted">Proposed in the spec, not yet binding.</p>
      {
        drafts.length === 0 ? (
          <p class="rfc-muted">No Draft requirements right now.</p>
        ) : (
          <ul class="rfc-list">
            {drafts.map((d) => (
              <li class="card rfc-item">
                <a href={d.url} target="_blank" rel="noopener" class="rfc-item__title">{d.id} — {d.title}</a>
                <div class="rfc-item__meta">
                  <span class="rfc-tag">area {d.area}</span>
                  <span>· Draft</span>
                </div>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>
</Base>

<style>
  .rfc-cta {
    display: inline-block;
    font-weight: 600;
    text-decoration: none;
  }
  .rfc-h {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .rfc-count {
    font-size: 0.8em;
    font-weight: 600;
    opacity: 0.6;
    border: 1px solid currentColor;
    border-radius: 999px;
    padding: 0 0.5rem;
  }
  .rfc-muted {
    opacity: 0.7;
  }
  .rfc-list {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    display: grid;
    gap: 0.75rem;
  }
  .rfc-item {
    padding: 1rem 1.25rem;
  }
  .rfc-item__title {
    font-weight: 600;
    text-decoration: none;
    display: block;
  }
  .rfc-item__meta {
    margin-top: 0.35rem;
    font-size: 0.85rem;
    opacity: 0.7;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    align-items: center;
  }
  .rfc-tag {
    font-size: 0.75rem;
    border: 1px solid currentColor;
    border-radius: 999px;
    padding: 0 0.5rem;
    opacity: 0.85;
  }
</style>
